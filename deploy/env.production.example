# 服务器 /opt/finscope/.env 的模板。复制到服务器后填写真实值；真实 .env 禁止入库。
# 生成随机串： openssl rand -hex 32

APP_ENV=production
# 当前用公网 IP + HTTP 访问；浏览器会丢弃 Secure cookie，所以必须显式关掉。
# 配好域名与 HTTPS 之后，删掉这一行（production 默认带 Secure）。
COOKIE_SECURE=false
APP_BASE_URL=http://121.199.8.235
FRONTEND_ORIGIN=http://121.199.8.235
FINSCOPE_WEB_PORT=80

# 数据库口令：只能用字母数字（会拼进连接串），如 openssl rand -hex 24
FINSCOPE_DB_PASSWORD=
# 至少 32 位；不能是示例值，否则 api 启动会拒绝
JWT_SECRET=
# api / worker / scheduler 共用；更换后库里已加密的密钥需要在界面重新填写
SETTINGS_ENCRYPTION_KEY=

DATA_MODE=live
LOG_LEVEL=INFO
ENABLE_NEWS=true
ALLOW_REGISTRATION=false

# 首个管理员：库里还没有管理员时按这三项创建一次
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 以下数据源密钥也可在登录后「数据管理 → 密钥与数据源配置」里填写（加密存库）
FRED_API_KEY=
TIINGO_API_KEY=
TUSHARE_TOKEN=
SEC_USER_AGENT=FinScopeAI research-admin@example.com

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
