# 本地密钥与虚拟环境
.env
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 前端
node_modules/
dist/
*.tsbuildinfo

# Playwright 的失败产物（截图/trace/报告）。docs/screenshots 是交付物，不在此列。
frontend/e2e/.artifacts/
frontend/playwright-report/
frontend/test-results/

# 运行时数据。示例目录保留，真实上传与导出不入库。
data/uploads/**
data/imports/**
data/exports/**
data/runtime/**
!data/**/.gitkeep

# 编辑器
.idea/
.vscode/
*.log
