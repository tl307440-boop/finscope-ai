APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
DATABASE_URL=postgresql+psycopg://finscope:change-me@db:5432/finscope
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
FRED_API_KEY=
# 美股日线：Tiingo 官方免费档（个人研究用，https://www.tiingo.com 注册即得）。留空则美股日线标 unavailable。
TIINGO_API_KEY=
SEC_USER_AGENT=FinScopeAI research-admin@example.com
TUSHARE_TOKEN=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
AI_DAILY_TOKEN_BUDGET=200000
ENABLE_NEWS=false
DATA_MODE=live
UPLOAD_MAX_MB=30
UPLOAD_MAX_PAGES=200
# 单份 PDF 的解析时间预算（秒）；超时即中止并写 parse_status=failed，不拖住 worker。
UPLOAD_PARSE_TIME_BUDGET_SECONDS=30
LOG_LEVEL=INFO
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
# ---- 任务调度（规格书 §11，进程入口 python -m app.workers.scheduler）----
SCHEDULER_ENABLED=true
# 触发时刻按此时区解释；A 股 15:00 收盘、SEC 申报时刻都按它算。
SCHEDULER_TIMEZONE=Asia/Shanghai
# 启动时是否立即跑一轮全部已登记 job（本地自检可临时开 true，生产保持 false）。
SCHEDULER_RUN_ON_STARTUP=false
# 逐个任务的开关；计算类与热点任务的执行器尚未接入，默认关闭（禁止假成功）。
SCHEDULER_ENABLE_FRED=true
SCHEDULER_ENABLE_A_STOCK_BARS=true
SCHEDULER_ENABLE_US_SEC_FILINGS=true
SCHEDULER_ENABLE_CN_STATEMENTS=true
SCHEDULER_ENABLE_US_BARS=true
SCHEDULER_ENABLE_UNIVERSE=true
# 美股日线每轮最多登记的标的数（Tiingo 免费档每小时 50 次）
SCHEDULER_US_BARS_MAX_SYMBOLS=30
# 按需抓取失败后的冷却分钟数
ONDEMAND_RETRY_COOLDOWN_MINUTES=15
SCHEDULER_ENABLE_FINANCIAL_METRICS=true
SCHEDULER_ENABLE_MACRO_REGIME=true
SCHEDULER_ENABLE_HOTSPOT_EVENTS=true
SCHEDULER_ENABLE_PARSE_DOCUMENT=true
# 兜底扫描 queued 文档的间隔（秒）。
SCHEDULER_PARSE_SWEEP_SECONDS=300
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ---- 账号与密钥管理 ----
# 为空时用 JWT_SECRET 派生加密主密钥；生产建议单独设置一个长随机串，且 api / worker / scheduler 必须一致。
# 注意：更换主密钥后，已加密存库的密钥将无法解密，需要管理员在界面里重新填写。
SETTINGS_ENCRYPTION_KEY=
# 登录页是否开放自助注册（管理员也可以在「数据管理 → 密钥与数据源配置」里随时切换）。注册出来的永远是普通研究员。
ALLOW_REGISTRATION=true
REGISTER_MAX_PER_HOUR=5
# ---- 中国宏观 / 热点 ----
SCHEDULER_ENABLE_CHINA_MACRO=true
# 热点只收官方披露（巨潮 / SEC）；留空则热点任务如实标记为不可用。
SCHEDULER_HOTSPOT_SOURCE=disclosures
