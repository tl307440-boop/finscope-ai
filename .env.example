APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
DATABASE_URL=postgresql+psycopg://finscope:change-me@db:5432/finscope
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
FRED_API_KEY=
# 美股日线：Tiingo 官方免费档（个人研究用，https://www.tiingo.com 注册即得）。留空则美股日线标 unavailable。
TIINGO_API_KEY=
# 必须是能联系到的真实邮箱。仍是 example.com 时，公告正文（巨潮、8-K）不会抓。
# 必须是真实联系邮箱。仍是 example.com 时，公告正文（巨潮 / 美股 8-K）不会抓取。
SEC_USER_AGENT=FinScopeAI research-admin@example.com
TUSHARE_TOKEN=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
AI_DAILY_TOKEN_BUDGET=200000
ENABLE_NEWS=false
DATA_MODE=live
UPLOAD_MAX_MB=30
UPLOAD_MAX_PAGES=200
# 单份 PDF 的解析时间预算（秒）；超时即中止并写 parse_status=failed，不拖住 worker。
UPLOAD_PARSE_TIME_BUDGET_SECONDS=30
LOG_LEVEL=INFO
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
# ---- 任务调度（规格书 §11，进程入口 python -m app.workers.scheduler）----
SCHEDULER_ENABLED=true
# 触发时刻按此时区解释；A 股 15:00 收盘、SEC 申报时刻都按它算。
SCHEDULER_TIMEZONE=Asia/Shanghai
# 启动时是否立即跑一轮全部已登记 job（本地自检可临时开 true，生产保持 false）。
SCHEDULER_RUN_ON_STARTUP=false
# 逐个任务的开关；计算类与热点任务的执行器尚未接入，默认关闭（禁止假成功）。
SCHEDULER_ENABLE_FRED=true
SCHEDULER_ENABLE_A_STOCK_BARS=true
SCHEDULER_ENABLE_US_SEC_FILINGS=true
SCHEDULER_ENABLE_CN_STATEMENTS=true
SCHEDULER_ENABLE_US_BARS=true
SCHEDULER_ENABLE_UNIVERSE=true
# 美股日线每轮最多登记的标的数（Tiingo 免费档每小时 50 次）
SCHEDULER_US_BARS_MAX_SYMBOLS=30
# 按需抓取失败后的冷却分钟数
ONDEMAND_RETRY_COOLDOWN_MINUTES=15
SCHEDULER_ENABLE_FINANCIAL_METRICS=true
SCHEDULER_ENABLE_MACRO_REGIME=true
SCHEDULER_ENABLE_HOTSPOT_EVENTS=true
SCHEDULER_ENABLE_PARSE_DOCUMENT=true
# 兜底扫描 queued 文档的间隔（秒）。
SCHEDULER_PARSE_SWEEP_SECONDS=300
# 美国宏观：单次同步允许的观察区间（天，365–73000）。FRED 的版本日上限由同步按段拆开，不受此限。
MACRO_SYNC_MAX_WINDOW_DAYS=36500
# 东方财富绑定：是否由 API 进程定时把已绑定用户的东财自选同步进来，以及间隔（秒）。
# 用户在「自选研究」页扫码绑定后才会生效；设为 false 只关闭后台定时，页面上仍可手动同步。
EASTMONEY_SYNC_ENABLED=true
EASTMONEY_SYNC_INTERVAL_SECONDS=300
# 美国经济页批量接口按频率返回的最近行数（1–20000）。调大会增加响应体积。
MACRO_BATCH_LIMIT_DAILY=2500
MACRO_BATCH_LIMIT_WEEKLY=600
MACRO_BATCH_LIMIT_OTHER=240
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
# ---- AI 问答 ----
# 每用户每分钟最多发起几轮（进程内滑动窗口）。
ASSISTANT_PER_MINUTE=6
# 每用户每个上海日历日最多几轮（按数据库计数）。
ASSISTANT_DAILY_LIMIT=200
# 同时调用模型的后台线程数；满了直接返回 429，不排队。
ASSISTANT_WORKERS=4
# 模型迟迟不返回时 SSE 心跳间隔（秒），须小于反代的读超时（nginx 为 180 秒）。
ASSISTANT_HEARTBEAT_SECONDS=15
# 处于 streaming 超过这个秒数的回答按失败处理。须大于模型超时。
ASSISTANT_STALE_SECONDS=300
# 数据工具总开关（灰度）。默认关：问答保持原来的白名单转述 / 固定说明。
# 打开且配了 LLM_* 后，模型按需调用数据工具作答，每个数字都要能在已查到的资料里找到。
# 管理员也可以在「集成设置」里改，5 秒内生效，不用重启；出问题随时关掉。
ASSISTANT_ENABLED=false
# 一个回合里模型最多调几轮工具（1–8）；用完后强制写叙述。
ASSISTANT_MAX_STEPS=4
# 一眼能看出要查什么的问题（如「美国 CPI」「沪深 300 PCR」）先直取数据，少等一轮模型。
ASSISTANT_FAST_PATH=true
# 一个回合里所有模型调用的总时长上限（秒）。超了只给已查到的数据。
# ASSISTANT_STALE_SECONDS 必须比它至少大 30 秒，启动时校验。
ASSISTANT_TURN_SECONDS=150
# 语料检索工具 corpus_search（目前语料只有用户自己上传的文档，仅本人可见）。改了要重启。
# 已有上传要先补进语料：python -m app.scripts.corpus_user_backfill
CORPUS_ENABLED=false
# 全文检索相关度下限，低于它的片段不给模型；0 表示命中即给。
CORPUS_MIN_RANK=0.0
# 联网检索。默认关。也可以在「集成设置」里打开并填写密钥，约 5 秒生效。结果不入库。
ASSISTANT_WEB_SEARCH_ENABLED=false
BRAVE_API_KEY=
BOCHA_API_KEY=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ---- 账号与密钥管理 ----
# 为空时用 JWT_SECRET 派生加密主密钥；生产建议单独设置一个长随机串，且 api / worker / scheduler 必须一致。
# 注意：更换主密钥后，已加密存库的密钥将无法解密，需要管理员在界面里重新填写。
SETTINGS_ENCRYPTION_KEY=
# 登录页是否开放自助注册（管理员也可以在「数据管理 → 密钥与数据源配置」里随时切换）。注册出来的永远是普通研究员。
ALLOW_REGISTRATION=true
REGISTER_MAX_PER_HOUR=5
# ---- 中国宏观 / 热点 ----
SCHEDULER_ENABLE_CHINA_MACRO=true
# 热点只收官方披露（巨潮 / SEC）；留空则热点任务如实标记为不可用。
SCHEDULER_HOTSPOT_SOURCE=disclosures
